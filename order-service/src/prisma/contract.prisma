// use prisma-8

// lifecycle of an errand, see the status rules in the order controller.
// Renamed from CREATED / PICKED_UP / COMPLETED; src/tasks/renameStatuses.ts converts old rows.
// A new order starts PENDING while the credit service holds its bounty (order.created ->
// credits.held / credits.hold.rejected), then becomes OPEN, or REJECTED if the hold failed.
enum OrderStatus {
    PENDING // waiting for the credit service to hold the bounty; nobody can see or accept it yet
    REJECTED // the credit hold failed (not enough credits, or no answer in time)
    OPEN // couriers can see and accept it
    ACCEPTED // a courier is on the way to collect it
    COLLECTED // the courier has the item
    DELIVERED // the courier delivered it; credits go to the courier
    CANCELLED // the requester cancelled before collection
    EXPIRED // not delivered by the deadline
}

// where the courier collects the item
enum PickupType {
    SUPPLIER // a registered supplier
    BUILDING // a place in a building, e.g. a friend's room
}

model Order {
    // UUID generated by the service (crypto.randomUUID()) when the order is created
    id String @id
    // prevents duplicate orders if the client retries a dropped connection
    idempotencyKey String? @unique

    // user ids from the user service, not foreign keys since they live in another database
    requesterId Int
    // null until a courier accepts
    courierId Int?
    // orders made before building pickups existed are all SUPPLIER
    pickupType PickupType @default(SUPPLIER)
    // the supplier from the supplier service; null for a BUILDING pickup
    supplierId Int?

    // a location (building) id from the supplier service, and where in it. A SUPPLIER pickup
    // is a preset spot: its building and floor are the supplier's, with no room.
    // Floors: ground is 1, basements negative (-1 = B1), no 0. Building and floor are null
    // only on supplier pickups made before they were stored
    pickupLocationId Int?
    pickupFloor Int?
    pickupRoom String? // e.g. "#01-23"

    // dropoff is always a building; null only on orders made before buildings were required
    dropoffLocationId Int?
    dropoffFloor Int?
    dropoffRoom String?

    // snapshots when the order was made, e.g. "Printer @ Com 2, Com 2, Level 1" or
    // "Com 2, Level 3, #01-23", so past orders still read correctly
    // if a supplier or building is renamed or deleted
    pickupLocation String
    dropoffLocation String
    itemDescription String // e.g. "Black gaming laptop"
    creditBounty Int // credits reserved for the errand
    additionalDetails String? // optional instructions

    status OrderStatus @default(OPEN)
    // unaccepted orders expire after this time
    expiresAt TimestamptzString
    createdAt TimestamptzString @default(now())
    updatedAt TimestamptzString @default(now())

    @@index([status])
    @@index([requesterId])
    @@index([courierId])
    // "order" is a reserved word in SQL, so the table is called "orders"
    @@map("orders")
}

// Transactional outbox: rows are written in the same transaction as the order change they
// describe, then relayed to RabbitMQ by src/rabbitmq/outbox.ts. This is what guarantees an
// order change and its event either both happen or neither does.
enum OutboxStatus {
    PENDING
    COMPLETED
}

model Outbox {
    id Int @id @default(autoincrement())
    // routing key on the app.events exchange, e.g. "order.created"
    topic String
    type String
    payload Json
    metadata Json? // Allowlisted W3C context, separate from business payload
    status OutboxStatus @default(PENDING)
    retryCount Int @default(0)
    errorMessage String?
    nextRetryAt TimestamptzString?
    createdAt TimestamptzString @default(now())

    @@index([status, createdAt])
    @@map("outbox")
}
