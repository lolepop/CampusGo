# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# frontend api gateway url. if using the the edge gateway, use /api
VITE_API_BASE_URL=/api

# ---- Auth / JWT -----------
JWT_ACCESS_SECRET=REPLACE_ME_ACCESS
JWT_ACCESS_TOKEN_TTL=15m

JWT_REFRESH_SECRET=REPLACE_ME_SECRET
JWT_REFRESH_TOKEN_TTL=30d

# queue
RABBITMQ_USER=admin
RABBITMQ_PASS=mysecretpassword
RABBITMQ_CONNECTION=amqp://admin:mysecretpassword@rabbitmq

# observability (opentelemetry, collector, prometheus, grafana)
OTEL_METRICS=true
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_PROTOCOL=http/protobuf
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_HEADERS=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# user service
USER_DB_URL=postgresql://postgres:mysecretpassword@user_db:5432/users
USER_DB_PW=mysecretpassword

# supplier service
SUPPLIER_DB_URL=postgresql://postgres:mysecretpassword@supplier_db:5432/suppliers
SUPPLIER_DB_PW=mysecretpassword

# order service
ORDER_DB_URL=postgresql://postgres:mysecretpassword@order_db:5432/orders
ORDER_DB_PW=mysecretpassword

# credit service
CREDIT_DB_URL=postgresql://postgres:mysecretpassword@credit:5432/credit
CREDIT_DB_PW=mysecretpassword
