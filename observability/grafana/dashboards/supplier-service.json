        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(campusgo_http_server_request_duration_seconds_count{service_name=\"supplier-service\",deployment_environment_name=~\"${environment:regex}\",http_route=~\"${route:regex}\",http_route!~\"${health:raw}\",http_response_status_code=~\"5..\"}[$__rate_interval])) or (sum(rate(campusgo_http_server_request_duration_seconds_count{service_name=\"supplier-service\",deployment_environment_name=~\"${environment:regex}\",http_route=~\"${route:regex}\",http_route!~\"${health:raw}\"}[$__rate_interval])) * 0)) / (sum(rate(campusgo_http_server_request_duration_seconds_count{service_name=\"supplier-service\",deployment_environment_name=~\"${environment:regex}\",http_route=~\"${route:regex}\",http_route!~\"${health:raw}\"}[$__rate_interval])) > 0)) and on() ((time() - max(campusgo_telemetry_heartbeat_seconds{service_name=\"supplier-service\",deployment_environment_name=~\"${environment:regex}\"}) < 45))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
