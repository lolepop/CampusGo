  "panels": [
    {
      "id": 1,
      "title": "Metrics pipeline",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Supplier service: native Deno HTTP/database metrics and correlated traces. No messaging, RPC, or outbox instrumentation applies to this service. Health checks are excluded by default; select Include to exercise health traffic."
      },
      "description": ""
    },
    {
      "id": 2,
      "title": "Collector scrape",
      "type": "stat",
      "description": "Whether Prometheus can scrape the application-metrics endpoint. UP alone does not prove the user service is exporting.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"otel-collector\"}) or vector(0)",
          "legendFormat": "Collector",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Estimated HTTP requests in selected range",
      "type": "stat",
      "description": "Reset-aware extrapolated increase, not an exact audit count. Requires multiple scrapes and excludes health checks by default.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(campusgo_http_server_request_duration_seconds_count{service_name=\"supplier-service\",deployment_environment_name=~\"${environment:regex}\",http_route=~\"${route:regex}\",http_route!~\"${health:raw}\"}[$__range]))",
          "legendFormat": "Requests",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 5xx fraction",
      "type": "stat",
      "description": "5xx / all responses over the rate window. Idle or absent telemetry shows no value, rather than a fabricated healthy 0%.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
