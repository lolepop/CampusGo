{
  "uid": "campusgo-rabbitmq",
  "title": "CampusGo / RabbitMQ diagnostics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "campusgo",
    "rabbitmq"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "vhost",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "campusgo-prometheus"
        },
        "query": {
          "query": "label_values(rabbitmq_detailed_queue_messages, vhost)",
          "refId": "Vhost"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Broker scrape available",
      "type": "stat",
      "description": "Broker exporter availability, independently of user-service OTLP.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rabbitmq\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue scrape available",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rabbitmq-queues\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Ready messages",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_ready{job=\"rabbitmq-queues\",vhost=~\"${vhost:regex}\"} and on() (sum(up{job=~\"rabbitmq|rabbitmq-queues\"} == 1) == 2)",
          "legendFormat": "{{vhost}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Unacknowledged messages",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_unacked{job=\"rabbitmq-queues\",vhost=~\"${vhost:regex}\"} and on() (sum(up{job=~\"rabbitmq|rabbitmq-queues\"} == 1) == 2)",
          "legendFormat": "{{vhost}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Consumers",
      "type": "timeseries",
      "description": "Excludes DLQs: they normally have no consumer. Missing queues remain unavailable, not zero.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_consumers{job=\"rabbitmq-queues\",vhost=~\"${vhost:regex}\",queue!~\".*[.]dlq\"} and on() (sum(up{job=~\"rabbitmq|rabbitmq-queues\"} == 1) == 2)",
          "legendFormat": "{{vhost}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Existing DLQ depth",
      "type": "timeseries",
      "description": "Actual declared DLQs only. User-service has no DLQ; this does not change broker topology.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
