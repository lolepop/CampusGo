      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=~\"${vhost:regex}\",queue=~\".*[.]dlq\"} and on() (sum(up{job=~\"rabbitmq|rabbitmq-queues\"} == 1) == 2)",
          "legendFormat": "{{vhost}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Acknowledgements / second",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
