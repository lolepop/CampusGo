          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rabbitmq_detailed_queue_messages_acked_total{job=\"rabbitmq-queues\",vhost=~\"${vhost:regex}\"}[$__rate_interval])",
          "legendFormat": "{{vhost}} / {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "campusgo-prometheus"
          },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Redeliveries / second",
