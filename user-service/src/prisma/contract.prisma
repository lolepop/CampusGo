// use prisma-8

model User {
    id Int @id @default(autoincrement())
    email String @unique
    hashedPassword String

    // TODO: profile picture, requires s3 presigned storage
    // profilePictureFileHash String?
    nickname String
    contact String?

    createdAt TimestamptzString @default(now())

    roles Role[]
}

model UserRole {
    userId Int
    roleId Int

    assignedAt TimestamptzString @default(now())
    sourceInviteId Int? @unique

    user User @relation(fields: [userId], references: [id])
    role Role  @relation(fields: [roleId], references: [id])
    sourceInvite AdminInviteCode?  @relation(fields: [sourceInviteId], references: [id])
    @@id([userId, roleId])
}

model Role {
    id Int @id @default(autoincrement())
    name String @unique

    associatedUsers User[]
}

model AdminInviteCode {
    id Int @id @default(autoincrement())
    code String @unique
    expiresAt  TimestamptzString
    createdAt TimestamptzString @default(now())

    acceptedByUserRole UserRole?
}

// outbox handles pending events bound for the event queue
enum OutboxStatus {
    PENDING
    FAILED
    COMPLETED
}

model Outbox {
    id Int @id @default(autoincrement())
    type String // e.g. userRegistered
    topic String // e.g. "user.registered"
    payload Json // serialised payload
    status OutboxStatus @default(PENDING)
    retryCount Int @default(0)
    errorMessage String?
    nextRetryAt DateTime?
    createdAt DateTime @default(now())

    @@index([status, createdAt]) // for background poller performance
    @@map("outbox")
}

